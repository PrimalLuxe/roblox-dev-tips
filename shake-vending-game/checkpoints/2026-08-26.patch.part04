+
+function TradingService:CancelForUser(userId, reason)
+    local session = self:GetSessionFor(userId)
+    if session then self:Cancel(session, reason or "Cancelled") end
+    self.PendingRequests[userId] = nil
+end
+
 function TradingService:Init(RemoteService,DataService,CosmeticService,ShowcaseService)
     self.RemoteService=RemoteService; self.DataService=DataService; self.CosmeticService=CosmeticService; self.ShowcaseService=ShowcaseService
     RemoteService.Events.RequestTrade.OnServerEvent:Connect(function(p,target) self:Request(p,target) end)
     RemoteService.Events.TradeAction.OnServerEvent:Connect(function(p,action,data) if type(action)=="string" then self:Action(p,action,data) end end)
-    RemoteService.Events.SettingsAction.OnServerEvent:Connect(function(p,action,value)
-        local profile=self.DataService:GetProfile(p); if not profile or type(action)~="string" then return end
-        if action=="trade_enabled" and type(value)=="boolean" then
-            profile.TradeSettings.Enabled=value
-            if not value then local s=self:GetSessionFor(p.UserId); if s then self:Cancel(s,"Trading disabled") end end
-            self.RemoteService.Events.Toast:FireClient(p,{Text=value and "Trade requests enabled" or "Trade requests disabled",Kind="Info"})
-        end
-    end)
     Players.PlayerRemoving:Connect(function(p) local s=self:GetSessionFor(p.UserId); if s then self:Cancel(s,"Player left") end; self.PendingRequests[p.UserId]=nil end)
 end
 
